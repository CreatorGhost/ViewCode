import * as NodeServices from "@effect/platform-node/NodeServices";
import { expect, it } from "@effect/vitest";
import * as Effect from "effect/Effect";
import * as FileSystem from "effect/FileSystem";
import * as Schema from "effect/Schema";

import { DevinSettings } from "@t3tools/contracts";

import { writeFakeCli } from "../../testUtils/fakeCli.ts";
import { checkDevinProviderStatus } from "../viewcode/devinStatus.ts";

const decodeDevinSettings = Schema.decodeSync(DevinSettings);

// A stand-in for `devin`: `--version` as 3000.6.11 prints it, and
// `models list --format json` answers like a signed-in or signed-out CLI.
const fakeDevinSource = [
  "const args = process.argv.slice(2).join(' ');",
  'if (args === "--version") {',
  '  process.stdout.write("devin 3000.6.11 (38b3cbd2)\\n");',
  "  process.exit(0);",
  "}",
  'if (args === "models list --format json") {',
  '  if (process.env.FAKE_DEVIN_SIGNED_IN === "1") {',
  '    process.stdout.write(JSON.stringify([{ family_uid: "swe-1-6", family_label: "SWE-1.6" }]));',
  "    process.exit(0);",
  "  }",
  '  process.stderr.write("Error: Not logged in. Run `devin auth login` to authenticate.\\n");',
  "  process.exit(1);",
  "}",
  "process.exit(9);",
  "",
].join("\n");

const probe = (environment: Record<string, string>) =>
  Effect.scoped(
    Effect.gen(function* () {
      const fs = yield* FileSystem.FileSystem;
      const directory = yield* fs.makeTempDirectoryScoped({ prefix: "t3code-devin-probe-" });
      const binaryPath = writeFakeCli({ directory, name: "devin", source: fakeDevinSource });
      const env: NodeJS.ProcessEnv = { ...process.env, ...environment };
      if (!environment.WINDSURF_API_KEY) delete env.WINDSURF_API_KEY;
      return yield* checkDevinProviderStatus(
        decodeDevinSettings({ enabled: true, binaryPath }),
        env,
      );
    }),
  );

it.layer(NodeServices.layer)("checkDevinProviderStatus", (it) => {
  it.effect("reports a missing binary as not installed", () =>
    Effect.gen(function* () {
      const snapshot = yield* checkDevinProviderStatus(
        decodeDevinSettings({ enabled: true, binaryPath: "/definitely/not/installed/devin" }),
      );
      expect(snapshot.installed).toBe(false);
      expect(snapshot.status).toBe("error");
    }),
  );

  it.effect("reads the version, the sign-in and the account's models", () =>
    Effect.gen(function* () {
      const snapshot = yield* probe({ FAKE_DEVIN_SIGNED_IN: "1" });
      expect(snapshot.version).toBe("3000.6.11");
      expect(snapshot.status).toBe("ready");
      expect(snapshot.auth.status).toBe("authenticated");
      expect(snapshot.models.map((model) => model.slug)).toEqual(["default", "swe-1-6"]);
      expect(snapshot.slashCommands.map((command) => command.name)).toEqual(["compact"]);
    }),
  );

  it.effect("warns, without blocking, when Devin is not signed in", () =>
    Effect.gen(function* () {
      const snapshot = yield* probe({});
      expect(snapshot.status).toBe("warning");
      expect(snapshot.auth.status).toBe("unauthenticated");
      expect(snapshot.message).toContain("devin auth login");
    }),
  );

  it.effect("counts WINDSURF_API_KEY as signed in", () =>
    Effect.gen(function* () {
      const snapshot = yield* probe({ WINDSURF_API_KEY: "key" });
      expect(snapshot.auth).toMatchObject({ status: "authenticated", type: "api_key" });
    }),
  );
});
