{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Exported types are part of our contracts even before they have consumers.
  "rules": { "types": "off", "nsTypes": "off" },
  // These executables are supplied by the OS or installed separately from npm.
  "ignoreBinaries": ["eas", "file", "mkfifo", "pkill", "pkg-config", "plutil", "sips"],
  "workspaces": {
    ".": {
      // Keep vendored reference repositories outside the root project.
      "project": ["*.{js,mjs,cjs,ts,mts,cts}", ".github/**/*.cjs"],
      "entry": [
        // CodeRabbit loads its configuration by filename.
        ".coderabbit.config.ts",
        ".github/scripts/thread-transfer-report.cjs",
      ],
      "vite": { "entry": [".github/**/*.test.cjs"] },
      "vitest": { "entry": [".github/**/*.test.cjs"] },
    },
    "scripts": {
      // Knip loads its preprocessor through a CLI option; native verification and
      // worktree setup (from t3.json) run directly.
      // ViewCode: build.sh, the npm pack step and the relay CLI run these directly;
      // the spawn trace loads through NODE_OPTIONS --require.
      "entry": [
        "knip-schemas.ts",
        "mobile-native-client.ts",
        "setup-worktree.ts",
        "build-state.ts",
        "pack-viewcode-npm.ts",
        "viewcode-relay.ts",
        "diagnostics/spawn-trace.cjs",
      ],
      // The `t3` npm package's files: copied into the package, never imported.
      "ignore": ["npm-launcher/**"],
    },
    "apps/server": {
      // Vite+ pack entries and the launcher used by installed background services.
      "entry": [
        "src/bin.ts!",
        "src/claude-history-worker.ts!",
        "src/mcp-stdio-bridge.ts!",
        "src/computer-use-driver.ts!",
        "src/viewcode-computer.ts!",
        "src/viewcode-browser.ts!",
        "src/viewcode-review.ts!",
        "scripts/cli.ts",
        "scripts/evaluate-thread-titles.ts",
        "scripts/measure-pr-preview.ts",
        "scripts/probe-claude-fork-local-rollback-replay.ts",
        "scripts/update-test-shard-weights.ts",
        "scripts/verify-background-live.ts",
        "src/provider/testFixtures/*.mjs",
      ],
      // Keep the transitive Effect runtime pinned for standalone npm installs.
      // The Vite+ web build prerequisite.
      // Native and disk-loaded provider packages stay external to the bundle; the
      // CLI archive and desktop sidecar stage them from this manifest.
      "ignoreDependencies": ["@effect/platform-node-shared", "@t3tools/web", "@napi-rs/keyring"],
      "ignoreIssues": {
        // ViewCode: upstream module whose exports upstream's ClaudeDriver uses; ViewCode's
        // driver reads banked resets through provider/viewcode/claudeResetCredits.ts.
        "src/provider/claudeResetCredits.ts": ["exports"],
        // ViewCode: an upstream merge dropped the only caller (lost wiring, not dead code).
        "src/provider/viewcode/claudeEnterprisePolicy.ts": ["exports"],
      },
    },
    "apps/desktop": {
      // Electron loads these bundles by filename rather than importing them.
      "entry": [
        "gnome-extension/extension.js!",
        "src/electron/WindowsForegroundFocusWorker.ts!",
        "src/snapShot/GlobalShiftShortcutWorker.ts!",
        "src/snapShot/RegionSnapShotWorker.ts!",
        "src/snapShot/SnapShotAccessibilityWorker.ts!",
        "src/boot.ts!",
        "src/compileCache.ts!",
        "src/main.ts!",
        "src/preload.ts!",
        "src/preview-pick-preload.ts!",
        "src/preview-pip-preload.ts!",
        "src/mac-permission-preload.ts!",
        "src/preview/Annotation.css!",
      ],
      // The injected runtime resolves Playwright by string; release tooling runs
      // electron-builder from this workspace, outside its package scripts.
      "ignoreDependencies": ["playwright-core", "electron-builder"],
      // ViewCode: unchanged upstream module; keep its exports as upstream has them.
      "ignoreIssues": { "src/telemetry/DesktopTelemetryPublisher.ts": ["exports"] },
    },
    "apps/web": {
      // Worktree setup (scripts/setup-worktree.ts) runs this directly. ViewCode's
      // brand lab is a standalone dev page with its own Vite config.
      "entry": ["scripts/warm-dep-cache.ts", "vite/brand-lab.config.ts", "src/brand-lab/main.tsx"],
      // UI component modules are copied and adapted as cohesive sets. Keep their
      // named subcomponents even before they have callers; the file audit still
      // reports an entire component module when nothing imports it.
      "ignoreIssues": {
        "src/components/ui/*.tsx": ["exports", "nsExports", "duplicates"],
        // ViewCode: upstream modules whose exports upstream uses in code ViewCode replaced
        // (its sidebar, welcome wizard and Usage page). Kept so upstream merges apply.
        "src/components/Sidebar.logic.ts": ["exports"],
        "src/components/Sidebar.snooze.ts": ["exports"],
        "src/components/chat/threadContextDrag.ts": ["exports"],
        "src/components/usage/UsageLimits.tsx": ["exports"],
        "src/onboarding/projectImport.logic.ts": ["exports"],
        // ViewCode: upstream merges dropped the only callers (lost wiring, not dead code).
        "src/components/ThreadStatusIndicators.tsx": ["exports"],
        "src/state/use-orchestration-command.ts": ["exports"],
        "src/components/connectPhone/ConnectPhoneDialog.tsx": ["exports"],
      },
      // ViewCode: upstream modules ViewCode's own sidebar and settings replaced.
      // Kept so upstream merges apply; anything else unused is still reported.
      "ignoreFiles": [
        "src/components/chat/ThreadContextDragGhost.tsx",
        "src/components/settings/ThemeWireframe.tsx",
        "src/hooks/useNowSecond.ts",
        "src/hooks/useThreadVisitedMigration.ts",
      ],
    },
    "apps/mobile": {
      // Expo loads plugins and the fingerprint config by string; Metro embeds the browser entry in the native WebView.
      "entry": [
        "index.ts!",
        "fingerprint.config.js",
        "plugins/*.cjs",
        "scripts/generate-device-stream.mts",
        "src/features/devices/device-stream.browser.ts!",
        "src/features/browser/preview-stream.browser.ts!",
      ],
      // Fonts are configured as asset paths; Expo autolinks the native packages.
      "ignoreDependencies": [
        "@expo-google-fonts/dm-sans",
        "@t3tools/mobile-review-diff-native",
        "@t3tools/mobile-terminal-native",
      ],
      // ViewCode: upstream screens and components that ViewCode's own mobile
      // navigation, thread view and settings replaced. Kept so upstream merges
      // apply; anything else unused is still reported.
      "ignoreFiles": [
        "scripts/sync-pierre-file-icons.mjs",
        "src/components/brandAssets.ts",
        "src/components/NewThreadButton.tsx",
        "src/components/ui/Chip.tsx",
        "src/components/ui/ControlPill.tsx",
        "src/components/ui/ErrorBanner.tsx",
        "src/components/ui/FloatingActionButton.tsx",
        "src/components/ui/FrostedCutout.tsx",
        "src/components/ui/GlassBackdrop.tsx",
        "src/components/ui/GlassSurface.tsx",
        "src/components/ui/ListActionRow.tsx",
        "src/components/ui/ListRow.tsx",
        "src/components/ui/ListSection.tsx",
        "src/components/ui/ListToggleRow.tsx",
        "src/components/ui/LoadingStrip.tsx",
        "src/components/ui/MenuPopup.tsx",
        "src/components/ui/NativeSwitch.tsx",
        "src/components/ui/NativeThemeHost.tsx",
        "src/components/ui/NavigationRow.tsx",
        "src/components/ui/Notice.tsx",
        "src/components/ui/NumberField.tsx",
        "src/components/ui/OverlayPortal.tsx",
        "src/components/ui/Progress.tsx",
        "src/components/ui/ScreenScrollView.tsx",
        "src/components/ui/Sheet.tsx",
        "src/components/ui/SliderRow.tsx",
        "src/components/ui/ThemedSwitch.tsx",
        "src/components/ui/Toast.tsx",
        "src/connection/pull-request-cache-store.ts",
        "src/features/browser/browser-preview-button.tsx",
        "src/features/browser/BrowserPreviewRouteScreen.tsx",
        "src/features/browser/BrowserTabMenu.tsx",
        "src/features/browser/browserTabs.ts",
        "src/features/browser/PreviewStreamWebView.tsx",
        "src/features/browser/ThreadBrowserFloat.tsx",
        "src/features/connection/PermissionUpdateNotice.tsx",
        "src/features/development/ComponentCatalogScreen.tsx",
        "src/features/development/NativeAppBarExample.tsx",
        "src/features/files/AudioFilePreview.tsx",
        "src/features/files/FilesHeader.tsx",
        "src/features/home/FabScrollContext.ts",
        "src/features/home/ThreadListFilters.tsx",
        "src/features/layout/createWorkspaceStackNavigator.tsx",
        "src/features/projects/SourceControlIcon.tsx",
        "src/features/prompt-links/prompt-link-actions.ts",
        "src/features/prompt-links/usePromptLinkResolver.ts",
        "src/features/prompt-links/useThreadPromptLink.ts",
        "src/features/pull-requests/guide/GuideNotice.tsx",
        "src/features/pull-requests/guide/GuideOutline.tsx",
        "src/features/pull-requests/guide/PullRequestGuideScreen.tsx",
        "src/features/pull-requests/guide/ReviewGuideExcerpt.tsx",
        "src/features/pull-requests/guide/useReviewGuide.ts",
        "src/features/pull-requests/PullRequestActivityFilters.tsx",
        "src/features/pull-requests/pullRequestAnimations.ts",
        "src/features/pull-requests/PullRequestMedia.tsx",
        "src/features/pull-requests/PullRequestSectionHeading.tsx",
        "src/features/pull-requests/usePullRequestConnected.ts",
        "src/features/pull-requests/usePullRequestEnvironmentFallback.ts",
        "src/features/pull-requests/usePullRequestListControls.ts",
        "src/features/settings/components/DatabaseStorageNotice.tsx",
        "src/features/settings/components/ScheduledTaskPromptField.tsx",
        "src/features/settings/components/SettingsDragHandle.tsx",
        "src/features/settings/scheduled-task-editor.tsx",
        "src/features/settings/ScheduledTaskPickerScreens.tsx",
        "src/features/settings/SettingsFollowUpRouteScreen.tsx",
        "src/features/settings/SettingsMicrophoneRouteScreen.tsx",
        "src/features/settings/SettingsProviderAccountsRouteScreen.tsx",
        "src/features/settings/SettingsScheduledTasksRouteScreen.tsx",
        "src/features/threads/BrowserAppIcon.tsx",
        "src/features/threads/ComposerAttachmentButton.tsx",
        "src/features/threads/ComposerQueuedEdit.tsx",
        "src/features/threads/CopyTextButton.tsx",
        "src/features/threads/McpAppFullscreenScreen.tsx",
        "src/features/threads/McpAppWebView.tsx",
        "src/features/threads/messageImageGallery.ts",
        "src/features/threads/ProjectCloneBanner.tsx",
        "src/features/threads/ProviderSubagentBar.tsx",
        "src/features/threads/SecretRequestCard.tsx",
        "src/features/threads/SubagentRow.tsx",
        "src/features/threads/SubagentStatusDot.tsx",
        "src/features/threads/thread-command-output.tsx",
        "src/features/threads/thread-context-divider.tsx",
        "src/features/threads/thread-handoff-row.tsx",
        "src/features/threads/thread-workflow-opening.tsx",
        "src/features/threads/ThreadAgentsSheet.tsx",
        "src/features/threads/ThreadMarkdownVideo.tsx",
        "src/features/threads/ThreadQueueControl.tsx",
        "src/features/threads/UsageLimitRecoveryCard.tsx",
        "src/features/threads/work-log-layout.tsx",
        "src/features/workspace/AndroidWorkspaceSidebar.tsx",
        "src/features/workspace/AndroidWorkspaceTabsProvider.tsx",
        "src/features/workspace/useAndroidWorkspaceSelection.ts",
        "src/features/workspace/WorkspaceDock.tsx",
        "src/features/workspace/WorkspaceRootScreen.tsx",
        "src/features/workspace/WorkspaceSidebarTabs.tsx",
        "src/features/workspace/WorkspaceToolbar.tsx",
        "src/lib/composerImageFit.ts",
        "src/lib/composerImageGallery.ts",
        "src/lib/contextImageGallery.ts",
        "src/lib/designTokens.ts",
        "src/lib/markdownFileIcons.ts",
        "src/lib/markdownLinkIcons.ts",
        "src/lib/providerClients.ts",
        "src/native/AndroidHingeObserver.tsx",
        "src/native/createV5StackNavigator.tsx",
        "src/native/EnrichedMarkdownText.tsx",
        "src/native/useEnrichedLinkVariants.ts",
        "src/native/useMarkdownImageSource.ts",
        "src/native/window-hinge-context.ts",
        "src/state/mcpApps.ts",
        "src/state/preview.ts",
        "src/state/v2-item-support.ts",
      ],
    },
    "apps/mobile/modules/t3-source-text": {
      // React Native codegen discovers component specifications by filename.
      "entry": ["src/*NativeComponent.ts!"],
    },
    // ViewCode keeps this module after upstream dropped it; the app imports its
    // package exports, which pnpm copies out of knip's view.
    "apps/mobile/modules/t3-markdown-text": {
      "entry": ["src/*NativeComponent.ts!", "react-native.config.js"],
    },
    "infra/viewcode-relay": {
      // wrangler.jsonc deploys this worker.
      "entry": ["src/worker.ts!"],
    },
    "infra/relay": {
      "entry": ["alchemy.run.ts!", "src/persistence/schema.ts!"],
    },
    "packages/*": {
      // These workspace packages are private to this monorepo.
      "includeEntryExports": true,
    },
    "packages/client-runtime": {
      "includeEntryExports": true,
      "ignoreIssues": {
        // ViewCode: upstream modules whose exports upstream uses in mobile and web code
        // ViewCode replaced. Kept so upstream merges apply.
        "src/state/models.ts": ["exports"],
        "src/state/subagentDisplay.ts": ["exports"],
        // ViewCode: upstream merges dropped the only callers (lost wiring, not dead code).
        "src/state/assets.ts": ["exports"],
        "src/operations/projects.ts": ["exports"],
      },
    },
    "packages/shared": {
      "includeEntryExports": true,
      // ViewCode: upstream's mobile theme picker uses it; ViewCode's picker replaced that one.
      "ignoreIssues": { "src/themePreview.ts": ["exports"] },
    },
    "packages/effect-acp": {
      "includeEntryExports": true,
      "entry": ["test/fixtures/*.ts"],
      // Generated upstream protocol definitions are retained as a complete set.
      "ignoreIssues": { "src/_generated/**": ["exports", "types"] },
    },
    "packages/effect-codex-app-server": {
      "includeEntryExports": true,
      "entry": ["test/fixtures/*.ts"],
      "ignoreIssues": { "src/_generated/**": ["exports", "types"] },
    },
    "packages/source-control-github": {
      // graphqlgen reads its config; the generated operations export every selection's class.
      "entry": ["graphql.config.ts"],
      "ignoreIssues": { "**/*.graphql.ts": ["exports", "types", "namespaceMembers"] },
    },
  },
}
