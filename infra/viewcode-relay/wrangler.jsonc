{
  // ViewCode Quick connect relay. Deployed by `scripts/viewcode-relay.ts deploy`,
  // which overrides `name` so each person's Worker is their own.
  "name": "viewcode-relay",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "RelayDurableObject" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayDurableObject"] }],
}
